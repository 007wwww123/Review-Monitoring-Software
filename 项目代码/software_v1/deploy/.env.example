MYSQL_DATABASE=fake_review
MYSQL_USER=fake_review_app
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-different-strong-password
DATABASE_URL=mysql+pymysql://fake_review_app:replace-with-strong-password@mysql:3306/fake_review
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=30
MODEL_ROOT=/app/models
MODEL_CONFIG_PATH=/app/configs/base.json
MODEL_CHECKPOINT_PATH=/app/models/checkpoints/model.pt
MODEL_MANIFEST_PATH=/app/configs/model_manifest.json
MODEL_CHECKPOINT_SHA256=fill-from-deployment
MODEL_BASE_PATH=/app/models/albert-base-v2
MODEL_TOKENIZER_PATH=/app/models/tokenizer
MODEL_PRELOAD_REQUIRED=true
MODEL_DEVICE=cuda
DATASET_ROOT=/controlled/datasets
EVALUATION_BATCH_SIZE=32
WORKER_POLL_SECONDS=2
MODEL_HOST_DIR=/absolute/host/path/to/models
DATASET_HOST_DIR=/absolute/host/path/to/datasets
WEB_PORT=8080
PYTORCH_BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
